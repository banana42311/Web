<div id="onb" class="onb" role="dialog" aria-label="Intro" hidden>
  <canvas id="onb-canvas"></canvas>
  <h1 class="onb-name">Ji Su Kim</h1>
  <div id="onb-dot" class="onb-dot"></div>
  <button id="onb-enter" class="onb-enter" type="button">Enter<span class="onb-enter-mark" aria-hidden="true">+</span></button>
</div>

<style>
  .onb {
    position: fixed; inset: 0; z-index: 9999;
    background: var(--bg, #1a1a1a);
    cursor: none;
    transition: opacity 1s ease;
  }
  .onb[hidden] { display: none; }
  .onb.is-leaving { opacity: 0; pointer-events: none; }
  #onb-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .onb-name { position:absolute;top:32px;left:clamp(20px,4vw,64px);color:var(--ink);font:500 32px/1.1 var(--font);letter-spacing:0;pointer-events:none; }
  .onb-dot {
    position: absolute; left: 0; top: 0;
    width: 15px; height: 15px; margin: -7.5px 0 0 -7.5px;
    border-radius: 50%; background: var(--accent, #2b2fc4);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent, #2b2fc4) 28%, transparent);
    pointer-events: none; will-change: transform;
    transition: box-shadow .5s ease;
  }
  .onb.is-hot .onb-dot {
    box-shadow: 0 0 0 7px color-mix(in srgb, var(--accent, #2b2fc4) 40%, transparent),
                0 0 30px 8px color-mix(in srgb, var(--accent, #2b2fc4) 65%, transparent);
  }
  .onb-enter {
    position: absolute; left: 0; top: 0;
    display:flex;align-items:center;gap:24px;padding:14px 20px;
    border:1px solid var(--ink-2);border-radius:999px;background:color-mix(in srgb,var(--bg) 65%,transparent);
    backdrop-filter:blur(8px);
    font-family: var(--font, "Space Grotesk", system-ui, sans-serif);
    font-size: 16.5px; font-weight: 500; letter-spacing: .02em; line-height: 1;
    white-space: nowrap;
    color: var(--ink);
    cursor: none; will-change: transform;
    transition: color .3s ease;
  }
  .onb.is-hot .onb-enter { color: #fff; }
  .onb-enter-mark {font-size:22px;line-height:1;font-weight:300;transition:transform .3s;}
  .onb.is-hot .onb-enter-mark {transform:rotate(90deg);}
  .onb-enter:focus-visible {outline:2px solid var(--ink);outline-offset:5px;}
  @media (hover: none) { .onb, .onb-enter { cursor: auto; } }
</style>

<script>
  const root = document.getElementById("onb") as HTMLDivElement;
  const forced = new URLSearchParams(location.search).has("intro");
  let seen = false;
  try { seen = sessionStorage.getItem("onb-seen") === "1"; } catch {}

  if (root && (forced || !seen)) {
    root.hidden = false;
    document.documentElement.style.overflow = "hidden";
    run(root);
  }

  function run(root: HTMLDivElement) {
    const canvas = document.getElementById("onb-canvas") as HTMLCanvasElement;
    const dot = document.getElementById("onb-dot") as HTMLDivElement;
    const btn = document.getElementById("onb-enter") as HTMLButtonElement;
    const ctx = canvas.getContext("2d")!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ---------- 색: 사이트의 --accent / --bg 를 그대로 읽어옴 ----------
    const rgbOf = (cssVar: string, fallback: string) => {
      const p = document.createElement("span");
      p.style.color = getComputedStyle(document.documentElement).getPropertyValue(cssVar).trim() || fallback;
      document.body.appendChild(p);
      const m = getComputedStyle(p).color.match(/[\d.]+/g)!;
      p.remove();
      return [+m[0], +m[1], +m[2]];
    };
    const ACC = rgbOf("--accent", "#2b2fc4");
    const BG = rgbOf("--bg", "#1a1a1a");
    const GREY = [190, 190, 190];

    // ---------- 3D Perlin noise (x, y, time) ----------
    const perm = new Uint8Array(512);
    { const p = Array.from({ length: 256 }, (_, i) => i);
      let s = 1337; const rnd = () => (s = (s * 16807) % 2147483647) / 2147483647;
      for (let i = 255; i > 0; i--) { const j = (rnd() * (i + 1)) | 0; [p[i], p[j]] = [p[j], p[i]]; }
      for (let i = 0; i < 512; i++) perm[i] = p[i & 255]; }
    const fade = (t: number) => t * t * t * (t * (t * 6 - 15) + 10);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const grad = (h: number, x: number, y: number, z: number) => {
      h &= 15; const u = h < 8 ? x : y, v = h < 4 ? y : h === 12 || h === 14 ? x : z;
      return ((h & 1) === 0 ? u : -u) + ((h & 2) === 0 ? v : -v);
    };
    function noise(x: number, y: number, z: number) {
      const X = Math.floor(x) & 255, Y = Math.floor(y) & 255, Z = Math.floor(z) & 255;
      x -= Math.floor(x); y -= Math.floor(y); z -= Math.floor(z);
      const u = fade(x), v = fade(y), w = fade(z);
      const A = perm[X] + Y, AA = perm[A] + Z, AB = perm[A + 1] + Z;
      const B = perm[X + 1] + Y, BA = perm[B] + Z, BB = perm[B + 1] + Z;
      return lerp(
        lerp(lerp(grad(perm[AA], x, y, z), grad(perm[BA], x - 1, y, z), u),
             lerp(grad(perm[AB], x, y - 1, z), grad(perm[BB], x - 1, y - 1, z), u), v),
        lerp(lerp(grad(perm[AA + 1], x, y, z - 1), grad(perm[BA + 1], x - 1, y, z - 1), u),
             lerp(grad(perm[AB + 1], x, y - 1, z - 1), grad(perm[BB + 1], x - 1, y - 1, z - 1), u), v), w);
    }

    // ---------- 상태 ----------
    const GAP = 24, LEN = 15, N_PART = 900, R = 230;
    let W = 0, H = 0, dpr = 1, cols = 0, rows = 0, scale = 0.0016;
    const ptr = { x: 0, y: 0, tx: 0, ty: 0, vx: 0, vy: 0, active: false, power: 0 };
    type P = { x: number; y: number; life: number; size: number; a: number };
    let parts: P[] = [];

    const spawn = (p?: P): P => {
      const q = p ?? ({} as P);
      q.x = Math.random() * W; q.y = Math.random() * H;
      q.life = 200 + Math.random() * 500; q.size = 0.5 + Math.random() * 1.1; q.a = 0.15 + Math.random() * 0.35;
      return q;
    };

    function resize() {
      dpr = Math.min(devicePixelRatio || 1, 2);
      W = innerWidth; H = innerHeight;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(W / GAP) + 1; rows = Math.ceil(H / GAP) + 1;
      scale = 1.6 / Math.max(W, 700);                 // 화면 폭당 소용돌이 ~1~2개
      parts = Array.from({ length: Math.round(N_PART * (W * H) / (1440 * 900)) }, () => spawn());
    }

    // 한 점에서의 흐름 벡터(+ 포인터 영향 w)
    let T = 0;
    function flow(x: number, y: number, out: number[]) {
      const n = noise(x * scale, y * scale, T) + 0.45 * noise(x * scale * 2.1 + 9, y * scale * 2.1 + 4, T * 1.3);
      const a = n * Math.PI * 2.1;
      let vx = Math.cos(a), vy = Math.sin(a), w = 0;
      if (ptr.power > 0.001) {
        const dx = x - ptr.x, dy = y - ptr.y, d2 = dx * dx + dy * dy;
        w = Math.exp(-d2 / (2 * (R * 0.55) ** 2)) * ptr.power;   // 부드러운 가우시안 영향
        if (w > 0.002) {
          const d = Math.sqrt(d2) || 1;
          // 점 주위를 감도는 성분 + 포인터가 움직이는 방향으로 끌려가는 성분
          const sx = -dy / d, sy = dx / d;
          vx = vx * (1 - w * 0.55) + sx * w * 0.55 + ptr.vx * w * 0.05;
          vy = vy * (1 - w * 0.55) + sy * w * 0.55 + ptr.vy * w * 0.05;
          const m = Math.hypot(vx, vy) || 1; vx /= m; vy /= m;
        }
      }
      out[0] = vx; out[1] = vy; out[2] = w; return out;
    }

    const mix = (c: number[], d: number[], t: number) =>
      `${(c[0] + (d[0] - c[0]) * t) | 0},${(c[1] + (d[1] - c[1]) * t) | 0},${(c[2] + (d[2] - c[2]) * t) | 0}`;

    // ---------- 프레임 ----------
    let raf = 0, last = performance.now();
    const f = [0, 0, 0];
    function frame(now: number) {
      const dt = Math.min((now - last) / 16.67, 3); last = now; T += 0.0016 * dt;

      // 점: 마우스가 없으면 스스로 천천히 떠다님
      if (!ptr.active) {
        const t = now / 1000;
        ptr.tx = W * (0.5 + 0.22 * Math.sin(t * 0.21) + 0.08 * Math.sin(t * 0.53));
        ptr.ty = H * (0.55 + 0.2 * Math.cos(t * 0.17) + 0.07 * Math.sin(t * 0.41));
      }
      const px = ptr.x, py = ptr.y;
      ptr.x += (ptr.tx - ptr.x) * 0.1 * dt; ptr.y += (ptr.ty - ptr.y) * 0.1 * dt;
      ptr.vx += ((ptr.x - px) - ptr.vx) * 0.2; ptr.vy += ((ptr.y - py) - ptr.vy) * 0.2;
      ptr.power += ((ptr.active ? 1 : 0.55) - ptr.power) * 0.04;
      dot.style.transform = `translate(${ptr.x}px, ${ptr.y}px)`;
      const buttonX = Math.max(btn.offsetWidth + 16, Math.min(W - 16, ptr.x - 24));
      const buttonY = Math.max(100, Math.min(H - 40, ptr.y));
      btn.style.transform = `translate(${buttonX}px, ${buttonY}px) translate(-100%, -50%)`;

      ctx.fillStyle = `rgb(${BG[0]},${BG[1]},${BG[2]})`;
      ctx.fillRect(0, 0, W, H);

      // 1) 격자 선 — 아주 흐리게, 포인터 근처만 블루로 번짐
      ctx.lineCap = "round"; ctx.lineWidth = 1;
      for (let i = 0; i < cols; i++) for (let j = 0; j < rows; j++) {
        const x = i * GAP, y = j * GAP; flow(x, y, f);
        const w = f[2], len = LEN * (1 + w * 0.7), al = 0.1 + w * 0.8;
        ctx.strokeStyle = `rgba(${mix(GREY, ACC, Math.min(1, w * 1.6))},${al})`;
        ctx.beginPath();
        ctx.moveTo(x - f[0] * len / 2, y - f[1] * len / 2);
        ctx.lineTo(x + f[0] * len / 2, y + f[1] * len / 2);
        ctx.stroke();
      }

      // 2) 입자 — 흐름을 타고 떠다니며 소용돌이 가장자리에 모임
      for (const p of parts) {
        flow(p.x, p.y, f);
        const sp = (0.28 + f[2] * 1.1) * dt;
        p.x += f[0] * sp; p.y += f[1] * sp; p.life -= dt;
        if (p.life <= 0 || p.x < -10 || p.y < -10 || p.x > W + 10 || p.y > H + 10) { spawn(p); continue; }
        const fadeIn = Math.min(1, p.life / 40, (700 - p.life) / 60 + 0.2);
        const t = Math.min(1, f[2] * 1.6);
        ctx.fillStyle = `rgba(${mix(GREY, ACC, t)},${Math.min(1, (p.a + f[2] * 0.7) * fadeIn)})`;
        ctx.beginPath(); ctx.arc(p.x, p.y, p.size * (1 + f[2] * 0.8), 0, 6.2832); ctx.fill();
      }
      if (!reduce) raf = requestAnimationFrame(frame);
    }

    // ---------- 입력 ----------
    const move = (x: number, y: number) => { ptr.tx = x; ptr.ty = y; if (!ptr.active) { ptr.active = true; } if (reduce) frame(performance.now()); };
    addEventListener("pointermove", (e) => move(e.clientX, e.clientY));
    root.addEventListener("pointerdown", (e) => move(e.clientX, e.clientY));
    btn.addEventListener("pointerenter", () => root.classList.add("is-hot"));
    btn.addEventListener("pointerleave", () => root.classList.remove("is-hot"));
    addEventListener("resize", resize);

    function enter() {
      if (root.classList.contains("is-leaving")) return;
      try { sessionStorage.setItem("onb-seen", "1"); } catch {}
      root.classList.add("is-leaving");
      document.documentElement.style.overflow = "";
      document.dispatchEvent(new CustomEvent("onboarding:done"));
      setTimeout(() => { root.hidden = true; cancelAnimationFrame(raf); }, 1050);
    }
    root.addEventListener("click", enter);
    addEventListener("keydown", (e) => { if (e.key === "Enter") enter(); });

    resize(); ptr.x = ptr.tx = W / 2; ptr.y = ptr.ty = H * 0.55;
    raf = requestAnimationFrame(frame);
  }
</script>
